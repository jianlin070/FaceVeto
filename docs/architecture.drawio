        <mxCell id="c67" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dadce0;align=left;verticalAlign=top;spacing=14;fontColor=#202124;shadow=0;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:6px&quot;&gt;How a post is checked&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding-right:18px&quot;&gt;&lt;table style=&quot;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Owner enrols their face with a live blink and head turn check&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Someone posts a photo and caption&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Faces are detected and embedded (InsightFace ArcFace)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;1:N match against opted-in templates (Firestore vector search)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;5&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;ADK agent asks Gemini to judge harm; it never sees who matched&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top&quot;&gt;&lt;table style=&quot;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;6&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Policy decides: publish, publish with FYI, or hold&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;7&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;The owner gets a real-time alert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;8&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Owner taps Not me (takedown) or It&amp;#x27;s me (publish)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;9&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Reviewer checks evidence in the admin console&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px 2px 0;vertical-align:top&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:22px;border-radius:11px;background:#202124;color:#fff;text-align:center;line-height:22px;font-size:12px;font-weight:bold&quot;&gt;10&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 0;vertical-align:top&quot;&gt;Logs stream to BigQuery (log sink) for analytics&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;margin-top:10px;padding-top:8px;border-top:1px solid #e8eaed;font-size:12.5px;color:#5f6368&quot;&gt;&lt;span style=&quot;color:#202124;font-weight:bold&quot;&gt;→&lt;/span&gt; moving line: live data flow &amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#d93025;font-weight:bold&quot;&gt;┄┄&lt;/span&gt; dashed box: roadmap&lt;br&gt;&lt;b style=&quot;color:#202124&quot;&gt;Privacy:&lt;/b&gt; no face search endpoint, the poster never sees match details, logs never hold faces, tokens or images.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="324" width="820" x="24" y="740" as="geometry" />
        </mxCell>
